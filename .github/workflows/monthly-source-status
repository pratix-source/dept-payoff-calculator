name: Monthly source and status check
on:
  schedule:
    - cron: '20 05 1 * *'
  workflow_dispatch:
permissions:
  contents: write
jobs:
  review:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: node scripts/monthly-source-status.mjs
      - run: npm test
      - name: Commit monthly status
        run: |
          if git diff --quiet; then
            echo "No status file change."
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data/monthly-update-status.json
          git commit -m "chore(data): record monthly source check"
          git push
